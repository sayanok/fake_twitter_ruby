<!DOCTYPE html>
<html>

<head>
  <title>Myapp</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= turbo_include_tags %>
  <%= javascript_importmap_tags %>
</head>

<body>
  <div class="container">
    <aside>
      <%= render 'layouts/sidebar' %>
    </aside>
    <main>
      <%= yield %>
    </main>
  </div>
</body>

</html>