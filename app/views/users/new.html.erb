<div class="row">
  <%= form_for(@user) do |f| %>
    <%= f.label :account_name %>
    <%= f.text_field :account_name %>

    <%= f.label :email %>
    <%= f.email_field :email %>

    <%= f.label :password %>
    <%= f.password_field :password %>

    <%= f.label :password_confirmation, "Confirmation" %>
    <%= f.password_field :password_confirmation %>

    <%= f.submit "Create my account", class: "btn btn-primary" %>
  <% end %>
</div>
