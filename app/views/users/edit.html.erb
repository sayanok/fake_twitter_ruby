<div class="row">
  <%= form_for(@user) do |f| %>
    <%= f.label :account_name %>
    <%= f.text_field :account_name %>

    <%= f.label :email %>
    <%= f.email_field :email %>

    <%= f.label :description %>
    <%= f.text_field :description %>

    <%= f.submit "update", class: "btn" %>
  <% end %>
</div>
